<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================================================================
         StockSense application menu.

         This file is the single source of truth for the menus of the module,
         therefore it has to be loaded last: the menu items reference the
         actions defined in views/product_views.xml,
         views/reorder_rule_views.xml and views/export_templates.xml.

         The top level menu is an application (it carries an icon and is listed
         in the Apps switcher). It also has an action, so opening the app lands
         directly on the Products list, which is its first sub-menu.
         ================================================================== -->

    <menuitem id="menu_stocksense_root"
        name="StockSense"
        web_icon="stock,static/description/icon.png"
        action="action_stocksense_product_template"
        sequence="85"
        groups="stock.group_stock_user"/>

    <menuitem id="menu_stocksense_product_template"
        name="Products"
        parent="menu_stocksense_root"
        action="action_stocksense_product_template"
        sequence="10"
        groups="stock.group_stock_user"/>

    <menuitem id="menu_stocksense_orderpoint"
        name="Reordering Rules"
        parent="menu_stocksense_root"
        action="action_stocksense_orderpoint"
        sequence="15"
        groups="stock.group_stock_user"/>

    <menuitem id="menu_stocksense_reorder_rule"
        name="Reorder Rules"
        parent="menu_stocksense_root"
        action="action_stocksense_reorder_rule"
        sequence="20"
        groups="stock.group_stock_user"/>

    <menuitem id="menu_stocksense_product_category"
        name="Product Categories"
        parent="menu_stocksense_root"
        action="action_stocksense_product_category"
        sequence="30"
        groups="stock.group_stock_manager"/>

    <!-- Merged from the "Dashboard & Adjustments" module. Their sequences are
         adapted (5 / 25) so that every StockSense sub-menu keeps a single,
         distinct position. -->
    <menuitem id="menu_stocksense_dashboard"
        name="Dashboard"
        parent="menu_stocksense_root"
        action="action_stocksense_dashboard"
        sequence="5"
        groups="stock.group_stock_user"/>

    <!-- Export to Excel / CSV: the dashboard figures as a list, which the
         cockpit (a form view) does not provide, so the native Export action can
         produce their CSV / Excel extract (views/export_templates.xml). -->
    <menuitem id="menu_stocksense_dashboard_data"
        name="Dashboard Data"
        parent="menu_stocksense_dashboard"
        action="action_stocksense_dashboard_data"
        sequence="10"
        groups="stock.group_stock_user"/>

    <menuitem id="menu_stock_adjustment"
        name="Inventory Adjustments"
        parent="menu_stocksense_root"
        action="action_stock_adjustment"
        sequence="25"
        groups="stock.group_stock_user"/>

</odoo>
